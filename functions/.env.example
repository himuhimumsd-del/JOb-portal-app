# Cashfree Sandbox Environment Variables Template
# Copy to functions/.env.local for local emulator testing ONLY.
# For production/cloud deployment, use Google Cloud Secret Manager via Firebase CLI:
#   firebase functions:secrets:set CASHFREE_APP_ID
#   firebase functions:secrets:set CASHFREE_SECRET_KEY
# NEVER commit real secret keys to source control.

CASHFREE_APP_ID=your_cashfree_sandbox_app_id_here
CASHFREE_SECRET_KEY=your_cashfree_sandbox_secret_key_here
